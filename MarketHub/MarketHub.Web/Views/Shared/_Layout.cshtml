@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – MarketHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" asp-controller="Home" asp-action="Index">MarketHub</a>

            <nav class="site-nav" aria-label="Main">
                <a asp-controller="Home" asp-action="Index">Home</a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="site-nav__user">@User.Identity?.Name</span>
                    <form class="site-nav__form" method="post" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                        <button type="submit" class="btn btn--ghost btn--sm">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn--primary btn--sm" asp-controller="Account" asp-action="Register">Create account</a>
                }
            </nav>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            &copy; @DateTime.Now.Year MarketHub
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
