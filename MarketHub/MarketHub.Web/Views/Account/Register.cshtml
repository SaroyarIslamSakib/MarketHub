@model MarketHub.Web.Models.RegisterModel

@{
    ViewData["Title"] = "Create account";
}

<section class="auth">
    <aside class="auth__aside">
        <h1 class="auth__headline">Open your MarketHub account.</h1>
        <p class="auth__lede">Buy, sell and keep track of everything with a single login.</p>
    </aside>

    <div class="auth__panel">
        <h2 class="auth__title">Create account</h2>
        <p class="auth__sub">
            Already registered?
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
        </p>

        <form method="post" asp-action="Register" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert--error" role="alert"></div>

            <div class="field">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" autocomplete="username" inputmode="email" autofocus />
                <span asp-validation-for="Email" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field__error"></span>
            </div>

            <button type="submit" class="btn btn--primary btn--block">Create account</button>
        </form>

        @if (Model.ExternalLogins?.Any() == true)
        {
            <div class="divider"><span>or sign up with</span></div>

            @* Requires an ExternalLogin POST action on AccountController *@
            <form method="post" asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" class="external">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="btn btn--outline btn--block" name="provider" value="@provider.Name">
                        @provider.DisplayName
                    </button>
                }
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
